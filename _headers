# =============================================================================
# ObraStock — cabeçalhos do Cloudflare Pages
# =============================================================================
# Este arquivo é lido automaticamente pelo Cloudflare Pages na publicação.
# Ele não precisa de nenhuma configuração no painel.
# =============================================================================

# ---------- Padrão para todo o site ----------
/*
  # Impede que o navegador "adivinhe" o tipo de um arquivo. Sem isto, um
  # arquivo enviado por um usuário poderia ser interpretado como script.
  X-Content-Type-Options: nosniff

  # Impede que o sistema seja embutido num iframe de outro site (clickjacking:
  # a vítima acha que está clicando numa página e está clicando na sua).
  X-Frame-Options: DENY

  # Não vaza o endereço interno do sistema para sites externos.
  Referrer-Policy: strict-origin-when-cross-origin

  # Desliga recursos que o sistema não usa.
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()

  # Força HTTPS por um ano, inclusive em subdomínios.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Política de conteúdo. Observação honesta: 'unsafe-inline' em script-src é
  # necessário porque o sistema é um HTML único com scripts embutidos — foi uma
  # decisão de arquitetura do protótipo. O ganho real aqui está em connect-src
  # (os dados só podem sair para o Supabase) e frame-ancestors (ninguém embute
  # o sistema). Para remover o 'unsafe-inline' seria preciso extrair os 14
  # blocos de script para arquivos .js separados.
  # ATENÇÃO ao mexer em connect-src: as fontes e o Font Awesome aparecem aqui
  # e isso parece errado à primeira vista — eles são CSS e fonte, deveriam
  # bastar style-src e font-src. Só que o service worker intercepta esses
  # pedidos e refaz com fetch(), e todo fetch() disparado pelo SW é julgado
  # como connect-src. Sem estas três origens aqui, o SW leva "Refused to
  # connect" e o site abre sem estilo nenhum. Já aconteceu em produção.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://esm.sh https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# ---------- Páginas: sempre conferir se há versão nova ----------
# Sem isto o usuário pode ficar semanas com uma versão antiga em cache.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/login.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Código da aplicação: nunca cachear por muito tempo ----------
# Aqui ficam as credenciais e as regras de autenticação. Se uma correção de
# segurança ficar presa no cache do navegador, ela simplesmente não existe.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Service worker ----------
# Precisa ser sempre fresco, senão o app nunca descobre que há atualização.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# ---------- Ícones: mudam junto com a versão, podem ficar em cache ----------
/icons/*
  Cache-Control: public, max-age=604800
